# Copy to .env and edit. NEVER commit .env.
# Generate a database password:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# ---- PostgreSQL (docker compose) ----
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me-generate-a-random-password
POSTGRES_DB=attendance

# ---- API ----
# development | production. In production AUTH_PROVIDER=dev is refused at startup.
ENVIRONMENT=development
# dev = accept "dev:<email>" tokens (LOCAL ONLY, no password). firebase = real Firebase ID tokens.
AUTH_PROVIDER=dev
FIREBASE_PROJECT_ID=
# Paste the service-account JSON on one line (use your platform's secret manager in production).
FIREBASE_CREDENTIALS_JSON=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
CURRENT_ACADEMIC_YEAR=2026/2027
CURRENT_SEMESTER=1

# ---- Web (compiled into the browser bundle: never put secrets here) ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_TIMEZONE=Africa/Lagos
