# Public (browser-visible) settings. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# "dev" = email-only sign-in against an API running AUTH_PROVIDER=dev (local development only)
# "firebase" = real Firebase Authentication
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# IANA timezone used to display times
NEXT_PUBLIC_TIMEZONE=Africa/Lagos
